# ============================================================
# GeoDetective KZ — переменные окружения
# Скопируй этот файл в .env.local и заполни значения
# ============================================================

# Supabase — создай проект на https://supabase.com (Free tier)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PostgreSQL connection string (из Supabase → Settings → Database → Connection string → URI)
# Формат: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/geodetective"

# ============================================================
# AI ПРОВАЙДЕР для оценки эссе — выбери ОДИН вариант
# ============================================================
# AI_PROVIDER управляет тем какой использовать: claude | openai | openrouter
# Если не задано — автоматически определяется по наличию ключей
AI_PROVIDER="claude"

# --- Вариант 1: Anthropic Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_GRADING_MODEL="claude-sonnet-4-6"

# --- Вариант 2: OpenAI (https://platform.openai.com) ---
# ChatGPT Plus подписка НЕ подходит — нужен отдельный API ключ
OPENAI_API_KEY=""
OPENAI_GRADING_MODEL="gpt-4o-mini"

# --- Вариант 3: OpenRouter (https://openrouter.ai) — много моделей, есть бесплатные ---
OPENROUTER_API_KEY=""
# Можно использовать "deepseek/deepseek-chat-v3" (бесплатно), "anthropic/claude-3.5-sonnet", "openai/gpt-4o-mini" и т.д.

# NextAuth/Session secret — сгенерируй: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Публичный URL приложения (для редиректов и emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
